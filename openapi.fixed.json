{
  "openapi": "3.1.2",
  "info": {
    "title": "Soenneker.Cloudflare.Clamav",
    "description": "ClamAV file scanning with Cloudflare Containers, private R2 uploads, D1 job state, and Queues delivery. Supply your deployment URL as the API base address.",
    "version": "v1"
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "Soenneker.Cloudflare.Clamav"
        ],
        "summary": "Checks HTTP host liveness.",
        "operationId": "Health",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        },
        "security": []
      }
    },
    "/ready": {
      "get": {
        "tags": [
          "Soenneker.Cloudflare.Clamav"
        ],
        "summary": "Checks the daemon and loaded signature freshness.",
        "operationId": "Ready",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/Ready401PlainResponseSchema"
                },
                "example": "Unauthorized"
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "ScannerApiKey": []
          }
        ]
      }
    },
    "/scan": {
      "post": {
        "tags": [
          "Soenneker.Cloudflare.Clamav"
        ],
        "summary": "Inspects raw file bytes under bounded resource limits.",
        "operationId": "Scan",
        "requestBody": {
          "description": "Raw file bytes, not multipart form data. The default upload limit is 100 MiB and can be configured by the operator.",
          "content": {
            "application/octet-stream": {
              "schema": {
                "$ref": "#/components/schemas/ScanOctetStreamRequestRequestBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VirusScanResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/Scan401PlainResponseSchema"
                },
                "example": "Unauthorized"
              }
            }
          },
          "408": {
            "description": "Request Timeout",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "413": {
            "description": "Payload Too Large",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "security": [
          {
            "ScannerApiKey": []
          }
        ]
      }
    },
    "/scan/jobs": {
      "post": {
        "tags": [
          "Soenneker.Cloudflare.Clamav"
        ],
        "summary": "Accepts a durable scan through the Worker; requires Idempotency-Key.",
        "operationId": "Queue",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "description": "Unique submission key, retained for seven days after completion. Reuse only with identical bytes.",
            "required": true,
            "schema": {
              "maxLength": 128,
              "type": "string"
            }
          },
          {
            "name": "X-Content-SHA256",
            "in": "header",
            "description": "Lowercase SHA-256 of the raw upload. Storage verifies this checksum before acceptance.",
            "required": true,
            "schema": {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            }
          },
          {
            "name": "Content-Length",
            "in": "header",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "description": "Raw file bytes, not multipart form data. The default upload limit is 100 MiB and can be configured by the operator.",
          "content": {
            "application/octet-stream": {
              "schema": {
                "$ref": "#/components/schemas/QueueOctetStreamRequestRequestBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "Accepted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VirusScanJobAcceptedResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/Queue401PlainResponseSchema"
                },
                "example": "Unauthorized"
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "413": {
            "description": "Payload Too Large",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "501": {
            "description": "Not Implemented",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "200": {
            "description": "Accepted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VirusScanJobAcceptedResponse"
                }
              }
            },
            "x-client-success-response-status": "202"
          }
        },
        "security": [
          {
            "ScannerApiKey": []
          }
        ]
      }
    },
    "/scan/jobs/{jobId}": {
      "get": {
        "tags": [
          "Soenneker.Cloudflare.Clamav"
        ],
        "summary": "Retrieves durable job state through the Worker.",
        "operationId": "GetJob",
        "parameters": [
          {
            "name": "jobId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VirusScanJobResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/GetJob401PlainResponseSchema"
                },
                "example": "Unauthorized"
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "501": {
            "description": "Not Implemented",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "security": [
          {
            "ScannerApiKey": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "HealthResponse": {
        "required": [
          "ready"
        ],
        "type": "object",
        "properties": {
          "ready": {
            "type": "boolean"
          },
          "engineVersion": {
            "type": [
              "null",
              "string"
            ]
          },
          "signatureVersion": {
            "type": [
              "null",
              "string"
            ]
          },
          "signatureDate": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          },
          "lastUpdateAt": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          }
        },
        "description": "Readiness of the daemon and its currently loaded signatures."
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "format": "int32",
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "integer"
              },
              {
                "type": "string"
              }
            ]
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "VirusScanJobAcceptedResponse": {
        "required": [
          "id",
          "status",
          "statusUrl"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "The job identifier in standard dashed GUID format.",
            "format": "uuid"
          },
          "status": {
            "$ref": "#/components/schemas/VirusScanJobAcceptedResponseStatus"
          },
          "statusUrl": {
            "type": "string",
            "description": "An absolute status URL when available, otherwise a path relative to the service root."
          }
        },
        "description": "Identifies an accepted background scan and the endpoint used to poll its progress."
      },
      "VirusScanJobResponse": {
        "required": [
          "id",
          "status",
          "result",
          "error",
          "createdAt",
          "completedAt"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "The job identifier in standard dashed GUID format.",
            "format": "uuid"
          },
          "status": {
            "$ref": "#/components/schemas/VirusScanJobResponseStatus"
          },
          "result": {
            "$ref": "#/components/schemas/VirusScanJobResponseResult"
          },
          "error": {
            "type": [
              "null",
              "string"
            ],
            "description": "A failure description for a failed job, otherwise \u0060null\u0060."
          },
          "createdAt": {
            "type": "string",
            "description": "The UTC timestamp at which the job was created.",
            "format": "date-time"
          },
          "completedAt": {
            "type": [
              "null",
              "string"
            ],
            "description": "The UTC timestamp at which the job completed or failed, or \u0060null\u0060 while pending.",
            "format": "date-time"
          },
          "attempts": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "description": "Number of processing leases acquired for this job.",
            "format": "int32",
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "string"
              }
            ]
          }
        },
        "description": "Represents a persisted snapshot of a background scan\u0027s lifecycle and outcome."
      },
      "VirusScanResponse": {
        "required": [
          "clean",
          "threat",
          "engine"
        ],
        "type": "object",
        "properties": {
          "clean": {
            "type": "boolean"
          },
          "threat": {
            "type": [
              "null",
              "string"
            ]
          },
          "engine": {
            "type": "string"
          },
          "verdict": {
            "$ref": "#/components/schemas/VirusScanResponseVerdict"
          },
          "reason": {
            "type": "string"
          },
          "scanId": {
            "type": "string"
          },
          "sha256": {
            "type": "string"
          },
          "size": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "format": "int64",
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "string"
              }
            ]
          },
          "engineVersion": {
            "type": "string"
          },
          "signatureVersion": {
            "type": "string"
          },
          "signatureDate": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          },
          "durationMilliseconds": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d\u002B)?(?:[eE][\u002B-]?\\d\u002B)?$",
            "format": "double",
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "string"
              }
            ]
          }
        },
        "description": "A scan verdict bound to the uploaded bytes and the loaded signature database."
      },
      "VirusScanJobResponseResult": {
        "oneOf": [
          {
            "type": "null"
          },
          {
            "description": "The scan verdict for a completed job, otherwise \u0060null\u0060.",
            "$ref": "#/components/schemas/VirusScanResponse"
          }
        ]
      },
      "Ready401PlainResponse": {
        "type": "string"
      },
      "ScanOctetStreamRequest": {
        "type": "string",
        "format": "binary"
      },
      "Scan401PlainResponse": {
        "type": "string"
      },
      "QueueOctetStreamRequest": {
        "type": "string",
        "format": "binary"
      },
      "Queue401PlainResponse": {
        "type": "string"
      },
      "GetJob401PlainResponse": {
        "type": "string"
      },
      "ExamplePayload": {
        "type": "object",
        "description": "Placeholder schema for path example refs"
      },
      "Ready401PlainResponseSchema": {
        "type": "string"
      },
      "ScanOctetStreamRequestRequestBody": {
        "type": "string",
        "format": "binary"
      },
      "Scan401PlainResponseSchema": {
        "type": "string"
      },
      "QueueOctetStreamRequestRequestBody": {
        "type": "string",
        "format": "binary"
      },
      "Queue401PlainResponseSchema": {
        "type": "string"
      },
      "GetJob401PlainResponseSchema": {
        "type": "string"
      },
      "VirusScanJobAcceptedResponseStatus": {
        "enum": [
          "queued",
          "processing",
          "completed",
          "failed"
        ],
        "type": "string",
        "description": "The current job status; an idempotent replay can return an already completed job.",
        "x-ms-enum": {
          "name": "VirusScanJobAcceptedResponseStatus",
          "modelAsString": false,
          "values": [
            {
              "value": "queued",
              "name": "Queued"
            },
            {
              "value": "processing",
              "name": "Processing"
            },
            {
              "value": "completed",
              "name": "Completed"
            },
            {
              "value": "failed",
              "name": "Failed"
            }
          ]
        }
      },
      "VirusScanJobResponseStatus": {
        "enum": [
          "queued",
          "processing",
          "completed",
          "failed"
        ],
        "type": "string",
        "description": "One of the serialized values defined by VirusScanJobStatus.",
        "x-ms-enum": {
          "name": "VirusScanJobResponseStatus",
          "modelAsString": false,
          "values": [
            {
              "value": "queued",
              "name": "Queued"
            },
            {
              "value": "processing",
              "name": "Processing"
            },
            {
              "value": "completed",
              "name": "Completed"
            },
            {
              "value": "failed",
              "name": "Failed"
            }
          ]
        }
      },
      "VirusScanResponseVerdict": {
        "enum": [
          "clean",
          "infected",
          "inconclusive",
          "error"
        ],
        "type": "string",
        "x-ms-enum": {
          "name": "VirusScanResponseVerdict",
          "modelAsString": false,
          "values": [
            {
              "value": "clean",
              "name": "Clean"
            },
            {
              "value": "infected",
              "name": "Infected"
            },
            {
              "value": "inconclusive",
              "name": "Inconclusive"
            },
            {
              "value": "error",
              "name": "Error"
            }
          ]
        }
      }
    },
    "securitySchemes": {
      "ScannerApiKey": {
        "type": "http",
        "description": "The operator-configured Scanner:ApiKey supplied as Authorization: Bearer \u003Ckey\u003E. This is an API key, not a JWT.",
        "scheme": "bearer"
      }
    }
  },
  "tags": [
    {
      "name": "Soenneker.Cloudflare.Clamav"
    }
  ]
}