{
  "openapi": "3.1.2",
  "info": {
    "title": "Soenneker.Cloudflare.Clamav",
    "description": "ClamAV file scanning with Cloudflare Containers, private R2 uploads, D1 job state, and Queues delivery. Supply your deployment URL as the API base address.",
    "version": "v1"
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "Soenneker.Cloudflare.Clamav"
        ],
        "summary": "Checks HTTP host liveness.",
        "operationId": "Health",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        },
        "security": [ ]
      }
    },
    "/ready": {
      "get": {
        "tags": [
          "Soenneker.Cloudflare.Clamav"
        ],
        "summary": "Checks the daemon and loaded signature freshness.",
        "operationId": "Ready",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "text/plain": {
                "schema": {
                  "type": "string"
                },
                "example": "Unauthorized"
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "ScannerApiKey": [ ]
          }
        ]
      }
    },
    "/scan": {
      "post": {
        "tags": [
          "Soenneker.Cloudflare.Clamav"
        ],
        "summary": "Inspects raw file bytes under bounded resource limits.",
        "operationId": "Scan",
        "requestBody": {
          "description": "Raw file bytes, not multipart form data. The default upload limit is 100 MiB and can be configured by the operator.",
          "content": {
            "application/octet-stream": {
              "schema": {
                "type": "string",
                "format": "binary"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VirusScanResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "text/plain": {
                "schema": {
                  "type": "string"
                },
                "example": "Unauthorized"
              }
            }
          },
          "408": {
            "description": "Request Timeout",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "413": {
            "description": "Payload Too Large",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "security": [
          {
            "ScannerApiKey": [ ]
          }
        ]
      }
    },
    "/scan/jobs": {
      "post": {
        "tags": [
          "Soenneker.Cloudflare.Clamav"
        ],
        "summary": "Accepts a durable scan through the Worker; requires Idempotency-Key.",
        "operationId": "Queue",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "description": "Unique submission key, retained for seven days after completion. Reuse only with identical bytes.",
            "required": true,
            "schema": {
              "maxLength": 128,
              "type": "string"
            }
          },
          {
            "name": "X-Content-SHA256",
            "in": "header",
            "description": "Lowercase SHA-256 of the raw upload. Storage verifies this checksum before acceptance.",
            "required": true,
            "schema": {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            }
          },
          {
            "name": "Content-Length",
            "in": "header",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "description": "Raw file bytes, not multipart form data. The default upload limit is 100 MiB and can be configured by the operator.",
          "content": {
            "application/octet-stream": {
              "schema": {
                "type": "string",
                "format": "binary"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "Accepted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VirusScanJobAcceptedResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "text/plain": {
                "schema": {
                  "type": "string"
                },
                "example": "Unauthorized"
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "413": {
            "description": "Payload Too Large",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "501": {
            "description": "Not Implemented",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "security": [
          {
            "ScannerApiKey": [ ]
          }
        ]
      }
    },
    "/scan/jobs/{jobId}": {
      "get": {
        "tags": [
          "Soenneker.Cloudflare.Clamav"
        ],
        "summary": "Retrieves durable job state through the Worker.",
        "operationId": "GetJob",
        "parameters": [
          {
            "name": "jobId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VirusScanJobResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "text/plain": {
                "schema": {
                  "type": "string"
                },
                "example": "Unauthorized"
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "501": {
            "description": "Not Implemented",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "security": [
          {
            "ScannerApiKey": [ ]
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "HealthResponse": {
        "required": [
          "ready"
        ],
        "type": "object",
        "properties": {
          "ready": {
            "type": "boolean"
          },
          "engineVersion": {
            "type": [
              "null",
              "string"
            ]
          },
          "signatureVersion": {
            "type": [
              "null",
              "string"
            ]
          },
          "signatureDate": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          },
          "lastUpdateAt": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          }
        },
        "description": "Readiness of the daemon and its currently loaded signatures."
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "VirusScanJobAcceptedResponse": {
        "required": [
          "id",
          "status",
          "statusUrl"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "The job identifier in standard dashed GUID format.",
            "format": "uuid"
          },
          "status": {
            "enum": [
              "queued",
              "processing",
              "completed",
              "failed"
            ],
            "type": "string",
            "description": "The current job status; an idempotent replay can return an already completed job."
          },
          "statusUrl": {
            "type": "string",
            "description": "An absolute status URL when available, otherwise a path relative to the service root."
          }
        },
        "description": "Identifies an accepted background scan and the endpoint used to poll its progress."
      },
      "VirusScanJobResponse": {
        "required": [
          "id",
          "status",
          "result",
          "error",
          "createdAt",
          "completedAt"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "The job identifier in standard dashed GUID format.",
            "format": "uuid"
          },
          "status": {
            "enum": [
              "queued",
              "processing",
              "completed",
              "failed"
            ],
            "type": "string",
            "description": "One of the serialized values defined by VirusScanJobStatus."
          },
          "result": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "description": "The scan verdict for a completed job, otherwise `null`.",
                "$ref": "#/components/schemas/VirusScanResponse"
              }
            ]
          },
          "error": {
            "type": [
              "null",
              "string"
            ],
            "description": "A failure description for a failed job, otherwise `null`."
          },
          "createdAt": {
            "type": "string",
            "description": "The UTC timestamp at which the job was created.",
            "format": "date-time"
          },
          "completedAt": {
            "type": [
              "null",
              "string"
            ],
            "description": "The UTC timestamp at which the job completed or failed, or `null` while pending.",
            "format": "date-time"
          },
          "attempts": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "description": "Number of processing leases acquired for this job.",
            "format": "int32"
          }
        },
        "description": "Represents a persisted snapshot of a background scan's lifecycle and outcome."
      },
      "VirusScanResponse": {
        "required": [
          "clean",
          "threat",
          "engine"
        ],
        "type": "object",
        "properties": {
          "clean": {
            "type": "boolean"
          },
          "threat": {
            "type": [
              "null",
              "string"
            ]
          },
          "engine": {
            "type": "string"
          },
          "verdict": {
            "enum": [
              "clean",
              "infected",
              "inconclusive",
              "error"
            ],
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "scanId": {
            "type": "string"
          },
          "sha256": {
            "type": "string"
          },
          "size": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int64"
          },
          "engineVersion": {
            "type": "string"
          },
          "signatureVersion": {
            "type": "string"
          },
          "signatureDate": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          },
          "durationMilliseconds": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          }
        },
        "description": "A scan verdict bound to the uploaded bytes and the loaded signature database."
      }
    },
    "securitySchemes": {
      "ScannerApiKey": {
        "type": "http",
        "description": "The operator-configured Scanner:ApiKey supplied as Authorization: Bearer <key>. This is an API key, not a JWT.",
        "scheme": "bearer"
      }
    }
  },
  "tags": [
    {
      "name": "Soenneker.Cloudflare.Clamav"
    }
  ]
}